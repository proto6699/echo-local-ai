# Echo Local AI v2
# The Den stays local unless you deliberately change this.
OPENWEBUI_BIND=127.0.0.1
OPENWEBUI_PORT=3000
# Optional override when Open WebUI is not on localhost.
# OPENWEBUI_URL=http://127.0.0.1:3000
WEBUI_SECRET_KEY=

# Must exactly match a model visible inside Open WebUI.
# The daemon itself talks to Open WebUI, so the underlying backend can be
# Ollama, LM Studio, llama.cpp, vLLM, or another OpenAI-compatible connection.
NECO_MODEL=llama3.2:1b
NECO_PERSONA=lite
NECO_CHAT_TITLE="Neco — idle"
OWNER_NAME=Echo
NECO_MACHINE="this machine"

# Idle behavior.
NECO_MIN_INTERVAL=1200
NECO_MAX_INTERVAL=2700
NECO_ERROR_INTERVAL=60
NECO_MAX_CONTEXT_MESSAGES=8

# Runtime / HTTP behavior.
NECO_STREAM=true
NECO_API_TIMEOUT=15
NECO_GENERATION_TIMEOUT=180
NECO_RETRY_ATTEMPTS=4
NECO_RETRY_BASE_SECONDS=2
NECO_VITALS_INTERVAL=5
