[Unit]
Description=Neco Idle Monologue
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/echo/neco-idle
ExecStart=/usr/bin/python3 -u /home/echo/neco-idle/neco_monologue.py
Restart=always
RestartSec=5
StandardOutput=append:/home/echo/neco-idle/neco.log
StandardError=append:/home/echo/neco-idle/neco.log

[Install]
WantedBy=default.target
